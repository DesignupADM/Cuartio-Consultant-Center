rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    /** @description Checks if the user is authenticated. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the user has an entry in the adminRoles collection (cached approach). */
    function isAdmin() {
      return isSignedIn() && (
        // Check custom claims first (preferred method)
        request.auth.token.get('roles', []).hasAny(['admin', 'super_admin']) ||
        // Check adminRoles collection with EXISTS check (more efficient than get())
        exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid))
      );
    }

    /** @description Checks if the provided UID matches the authenticated user's UID. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Checks ownership and ensures the document exists for updates/deletes. */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /** @description Checks if the user is an admin and the document exists. */
    function isExistingAdmin() {
      return isAdmin() && resource != null;
    }

    // --- Data Validation Functions ---

    /** @description Validates required fields exist in document. */
    function hasRequiredFields(requiredFields) {
      return requiredFields.all(field => field in request.resource.data);
    }

    /** @description Validates field types. */
    function validateFieldTypes(fieldTypes) {
      return fieldTypes.all(field => 
        field.type == 'string' && typeof request.resource.data[field.name] == 'string' ||
        field.type == 'number' && typeof request.resource.data[field.name] == 'number' ||
        field.type == 'boolean' && typeof request.resource.data[field.name] == 'boolean' ||
        field.type == 'timestamp' && request.resource.data[field.name] is timestamp ||
        field.type == 'array' && request.resource.data[field.name] is list ||
        field.type == 'map' && request.resource.data[field.name] is map
      );
    }

    /** @description Validates string length constraints. */
    function validateStringLength(fieldName, minLength, maxLength) {
      return request.resource.data[fieldName] is string &&
             request.resource.data[fieldName].size() >= minLength &&
             request.resource.data[fieldName].size() <= maxLength;
    }

    /** @description Validates email format. */
    function isValidEmail(fieldName) {
      return request.resource.data[fieldName] is string &&
             request.resource.data[fieldName].matches('^[^@]+@[^@]+\\.[^@]+$');
    }

    /** @description Validates URL format. */
    function isValidUrl(fieldName) {
      return request.resource.data[fieldName] is string &&
             request.resource.data[fieldName].matches('^https?://.+');
    }

    /** @description Validates timestamp is not in the past for deadlines. */
    function isFutureTimestamp(fieldName) {
      return request.resource.data[fieldName] is timestamp &&
             request.resource.data[fieldName] > request.time;
    }

    /** @description Prevents ID tampering - ensures document ID matches data.id field. */
    function idMatchesDataId() {
      return request.resource.data.id == request.resource.__name__.split('/').last();
    }

    /** @description Validates array size constraints. */
    function validateArraySize(fieldName, minSize, maxSize) {
      return request.resource.data[fieldName] is list &&
             request.resource.data[fieldName].size() >= minSize &&
             request.resource.data[fieldName].size() <= maxSize;
    }

    /** @description Prevents certain fields from being modified. */
    function isImmutableField(fieldName) {
      return !(fieldName in request.resource.data) ||
             fieldName in resource.data && request.resource.data[fieldName] == resource.data[fieldName];
    }

    /** @description Rate limiting helper - limits writes per user. */
    function isUnderRateLimit(limitPerMinute) {
      return request.time > resource.data.lastWriteTimestamp.seconds * 1000 + 60000 / limitPerMinute;
    }

    /** @description Audit logging - automatically logs all writes to systemLogs. */
    function logAuditEvent(collection, documentId, operation, changes) {
      // This function would be called by Cloud Functions after write operations
      // For now, we'll just ensure systemLogs are properly protected
      return true;
    }

    /** @description IP-based rate limiting (basic). */
    function isAllowedByIpRateLimit() {
      // Basic IP rate limiting - in production, use Firebase App Check or a proper rate limiter
      return true;
    }

    /** @description Validates phone number format. */
    function isValidPhoneNumber(fieldName) {
      return !(fieldName in request.resource.data) ||
             request.resource.data[fieldName] is string &&
             request.resource.data[fieldName].matches('^\\+?[1-9]\\d{1,14}$');
    }

    /** @description Validates social security/ID number format. */
    function isValidIdNumber(fieldName) {
      return !(fieldName in request.resource.data) ||
             request.resource.data[fieldName] is string &&
             request.resource.data[fieldName].size() >= 6 &&
             request.resource.data[fieldName].size() <= 20;
    }

    /** @description Validates salary/compensation range. */
    function isValidSalary(fieldName) {
      return !(fieldName in request.resource.data) ||
             request.resource.data[fieldName] is number &&
             request.resource.data[fieldName] >= 0 &&
             request.resource.data[fieldName] <= 1000000; // 1 million max
    }

    // --- Collection Rules ---

    /**
     * @description Role verification for Administrators.
     */
    match /adminRoles/{userId} {
      // Field-level security for admin roles
      function getFieldLevelSecurity() {
        // Determine which fields the user can see
        let isRequestingOwnRole = isOwner(userId);
        let isAdminUser = isAdmin();
        
        // All users can see their own admin status
        if (isRequestingOwnRole) {
          return {
            canRead: ['assignedAt', 'assignedBy', 'level', 'status'],
            canWrite: [] // No one can write directly - use Cloud Functions
          };
        }
        
        // Admins can see all fields for all admin roles
        if (isAdminUser) {
          return {
            canRead: ['assignedAt', 'assignedBy', 'level', 'status', 'notes'],
            canWrite: [] // No one can write directly - use Cloud Functions
          };
        }
        
        // Default: no access
        return {
          canRead: [],
          canWrite: []
        };
      }
      
      // Field mask for reads
      function getFieldMask() {
        let security = getFieldLevelSecurity();
        return resource.data.keys().hasOnly(security.canRead);
      }
      
      // Field validation for writes (should only happen via Cloud Functions)
      function isValidAdminRoleUpdate() {
        // Admin roles should only be created/updated via Cloud Functions
        // This is a safety check - regular users should not be able to modify
        return false;
      }
      
      allow get: if (isOwner(userId) || isAdmin()) && getFieldMask();
      allow list: if isAdmin();
      allow create, update, delete: if false; // Only via Cloud Functions
    }

    /**
     * @description Role verification for Consultants.
     */
    match /consultantRoles/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update, delete: if false;
    }

    /**
     * @description Stores comprehensive profiles. Document ID matches Auth UID.
     */
    match /consultantProfiles/{consultantId} {
      // Schema validation for consultant profiles
      function isValidConsultantProfile() {
        // Required fields
        let hasRequired = hasRequiredFields(['id', 'email', 'firstName', 'lastName']);
        
        // Field type validation
        let hasValidTypes = validateFieldTypes([
          {name: 'id', type: 'string'},
          {name: 'email', type: 'string'},
          {name: 'firstName', type: 'string'},
          {name: 'lastName', type: 'string'},
          {name: 'profession', type: 'string'},
          {name: 'sector', type: 'string'},
          {name: 'status', type: 'string'},
          {name: 'createdAt', type: 'timestamp'}
        ]);
        
        // String length constraints
        let hasValidLengths = 
          validateStringLength('firstName', 1, 100) &&
          validateStringLength('lastName', 1, 100) &&
          validateStringLength('profession', 0, 200) &&
          validateStringLength('sector', 0, 100);
        
        // Email validation
        let hasValidEmail = isValidEmail('email');
        
        // ID must match document ID
        let hasMatchingId = idMatchesDataId();
        
        // Status must be one of allowed values
        let hasValidStatus = request.resource.data.status in ['active', 'inactive', 'pending', 'suspended'];
        
        // Timestamp validation (createdAt should be current time on create)
        let hasValidTimestamps = 
          (request.method == 'create' && request.resource.data.createdAt == request.time) ||
          (request.method == 'update' && isImmutableField('createdAt'));
        
        return hasRequired && hasValidTypes && hasValidLengths && 
               hasValidEmail && hasMatchingId && hasValidStatus && hasValidTimestamps;
      }
      
      // Field-level security - prevent modification of sensitive fields
      function hasValidFieldUpdates() {
        // These fields cannot be modified after creation
        let immutableFieldsValid = 
          isImmutableField('id') &&
          isImmutableField('email') &&
          isImmutableField('createdAt') &&
          isImmutableField('uid');
        
        // Role field can only be modified by admins
        let roleValid = 
          !('role' in request.resource.data) ||
          (isAdmin() && request.resource.data.role in ['consultant', 'admin']);
        
        return immutableFieldsValid && roleValid;
      }
      
      allow get: if isOwner(consultantId) || isAdmin();
      allow list: if isAdmin();
      allow create: if 
        (isOwner(consultantId) || isAdmin()) && 
        request.resource.data.id == consultantId &&
        isValidConsultantProfile();
      
      allow update: if 
        (isExistingOwner(consultantId) || isExistingAdmin()) && 
        request.resource.data.id == resource.data.id &&
        isValidConsultantProfile() &&
        hasValidFieldUpdates();
      
      allow delete: if isAdmin();
    }

    /**
     * @description Consulting opportunities for consultants to browse.
     */
    match /opportunities/{opportunityId} {
      // Schema validation for opportunities
      function isValidOpportunity() {
        // Required fields
        let hasRequired = hasRequiredFields(['title', 'description', 'sector', 'status']);
        
        // Field type validation
        let hasValidTypes = validateFieldTypes([
          {name: 'title', type: 'string'},
          {name: 'description', type: 'string'},
          {name: 'sector', type: 'string'},
          {name: 'location', type: 'string'},
          {name: 'deadline', type: 'timestamp'},
          {name: 'budget', type: 'number'},
          {name: 'status', type: 'string'},
          {name: 'createdBy', type: 'string'},
          {name: 'createdAt', type: 'timestamp'},
          {name: 'updatedAt', type: 'timestamp'}
        ]);
        
        // String length constraints
        let hasValidLengths = 
          validateStringLength('title', 5, 200) &&
          validateStringLength('description', 20, 5000) &&
          validateStringLength('sector', 1, 100) &&
          validateStringLength('location', 0, 200);
        
        // Deadline must be in the future
        let hasValidDeadline = 
          !('deadline' in request.resource.data) ||
          isFutureTimestamp('deadline');
        
        // Budget validation (if present)
        let hasValidBudget = 
          !('budget' in request.resource.data) ||
          request.resource.data.budget >= 0;
        
        // Status validation
        let hasValidStatus = request.resource.data.status in ['draft', 'published', 'closed', 'archived'];
        
        // Timestamp validation
        let hasValidTimestamps = 
          (request.method == 'create' && request.resource.data.createdAt == request.time) ||
          (request.method == 'update' && 
           isImmutableField('createdAt') &&
           request.resource.data.updatedAt == request.time);
        
        // CreatedBy must match current user ID for creates
        let hasValidCreator = 
          (request.method == 'create' && request.resource.data.createdBy == request.auth.uid) ||
          (request.method == 'update' && isImmutableField('createdBy'));
        
        return hasRequired && hasValidTypes && hasValidLengths && 
               hasValidDeadline && hasValidBudget && hasValidStatus && 
               hasValidTimestamps && hasValidCreator;
      }
      
      allow get, list: if isSignedIn();
      allow create: if isAdmin() && isValidOpportunity();
      allow update, delete: if isExistingAdmin() && isValidOpportunity();

      match /applicants/{userId} {
        // Validation for applicant data
        function isValidApplication() {
          let hasRequired = hasRequiredFields(['opportunityId', 'applicantId', 'status', 'appliedAt']);
          
          let hasValidTypes = validateFieldTypes([
            {name: 'opportunityId', type: 'string'},
            {name: 'applicantId', type: 'string'},
            {name: 'status', type: 'string'},
            {name: 'coverLetter', type: 'string'},
            {name: 'appliedAt', type: 'timestamp'},
            {name: 'updatedAt', type: 'timestamp'}
          ]);
          
          let hasValidStatus = request.resource.data.status in ['pending', 'reviewed', 'accepted', 'rejected'];
          
          let hasValidTimestamps = 
            (request.method == 'create' && request.resource.data.appliedAt == request.time) ||
            (request.method == 'update' && request.resource.data.updatedAt == request.time);
          
          // Applicant ID must match the path userId
          let hasMatchingApplicantId = request.resource.data.applicantId == userId;
          
          // Users can only apply to themselves
          let isSelfApplication = request.resource.data.applicantId == request.auth.uid;
          
          return hasRequired && hasValidTypes && hasValidStatus && 
                 hasValidTimestamps && hasMatchingApplicantId && isSelfApplication;
        }
        
        allow get: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidApplication();
        allow update, delete: if isAdmin() && isValidApplication();
        allow list: if isAdmin();
      }
    }

    /**
     * @description Master data collections (Skills, Languages, Expertises, etc.).
     */
    match /skills/{docId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isExistingAdmin();
    }
    match /languages/{docId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isExistingAdmin();
    }
    match /areasOfExpertise/{docId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isExistingAdmin();
    }
    match /areasOfPractice/{docId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isExistingAdmin();
    }
    match /sectorsOfExperience/{docId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isExistingAdmin();
    }
    match /disciplines/{docId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isExistingAdmin();
    }
    match /degrees/{docId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isExistingAdmin();
    }
    match /regions/{docId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isExistingAdmin();
    }
    match /countries/{docId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isExistingAdmin();
    }

    /**
     * @description Global system logs for audit and management.
     */
    match /systemLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isExistingAdmin();
    }

    /**
     * @description Notifications targeted at specific consultants.
     */
    match /consultantNotifications/{consultantId}/notifications/{notificationId} {
      allow get, list: if isOwner(consultantId) || isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isExistingAdmin();
    }

    /**
     * @description System-wide settings and dynamic form questions.
     */
    match /settings/{docId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /settings/registration/questions/{questionId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
