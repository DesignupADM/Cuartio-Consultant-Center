# Firebase Web App (NEXT_PUBLIC_* values are embedded in the client bundle)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=studio-994542503-84bfe
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google GenAI (required for AI CV insights, opportunity generator, and matchmaking)
GEMINI_API_KEY=

# Resend email service (required for notifications and applicant status emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Curatio International Foundation <notifications@curatio.com>

# Firebase Admin SDK credentials for server-side routes (/api/email).
# On Firebase App Hosting this is optional (Application Default Credentials are used automatically).
# For local development, paste the full service account JSON here or use GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Secret for the consultant directory webhook (POST /api/webhooks/consultants).
# Requests must be signed with HMAC-SHA256 (X-Curatio-Signature: sha256=<hex>)
# or carry Authorization: Bearer <WEBHOOK_SECRET>.
WEBHOOK_SECRET=
