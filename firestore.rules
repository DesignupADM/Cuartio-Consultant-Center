rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    match /adminRoles/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /consultantRoles/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update, delete: if false;
    }

    match /consultantProfiles/{consultantId} {
      allow get: if isOwner(consultantId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() || (
        isOwner(consultantId) &&
        request.resource.data.id == consultantId &&
        !request.resource.data.keys().hasAny(['aiInsight']) &&
        (!request.resource.data.keys().hasAny(['status']) || request.resource.data.status == 'pending') &&
        (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'consultant')
      );
      allow update: if isAdmin() || (
        isOwner(consultantId) &&
        request.resource.data.id == resource.data.id &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'aiInsight', 'role', 'source', 'email']))
      );
      allow delete: if isAdmin();
    }

    match /opportunities/{opportunityId} {
      // Public share links only expose open projects. Signed-in users may also
      // read closed ones; drafts stay admin-only.
      allow get: if resource.data.status == 'open' ||
        (isSignedIn() && (isAdmin() || resource.data.status == 'closed'));
      allow list: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();

      match /applicants/{userId} {
        allow get: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && request.resource.data.status == 'applied';
        allow update, delete: if isAdmin();
        allow list: if isAdmin();
      }
    }

    match /skills/{docId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /languages/{docId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /areasOfExpertise/{docId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /areasOfPractice/{docId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /sectorsOfExperience/{docId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /disciplines/{docId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /degrees/{docId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /regions/{docId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /countries/{docId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /systemLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /_system/{docId} {
      allow get, list: if isAdmin();
    }

    match /consultantNotifications/{consultantId}/notifications/{notificationId} {
      allow get, list: if isOwner(consultantId) || isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /settings/{docId} {
      // Only the public site settings document is world-readable; every other
      // settings document is admin-only.
      allow get: if docId == 'global' || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /settings/registration/questions/{questionId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /opportunityFields/{fieldId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{path=**}/applicants/{userId} {
      allow list: if isSignedIn() && (request.auth.uid == resource.data.uid || isAdmin());
      allow get: if isOwner(userId) || isAdmin();
    }
  }
}