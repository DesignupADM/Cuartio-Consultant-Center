rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if user is an owner of the path
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Helper to check if user is an admin using custom claims
    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.get('roles', []).hasAny(['admin', 'super_admin']);
    }

    // File validation functions
    function isValidImage() {
      // Check file size (max 5MB for images)
      return request.resource.size < 5 * 1024 * 1024 &&
             // Check MIME type
             request.resource.contentType.matches('image/(jpeg|png|gif|webp)') &&
             // Check file extension
             request.resource.name.matches('.*\\.(jpg|jpeg|png|gif|webp)$');
    }

    function isValidDocument() {
      // Check file size (max 10MB for documents)
      return request.resource.size < 10 * 1024 * 1024 &&
             // Check MIME type for common document formats
             request.resource.contentType.matches('application/(pdf|msword|vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document|vnd\\.ms-excel|vnd\\.openxmlformats-officedocument\\.spreadsheetml\\.sheet)') &&
             // Check file extension
             request.resource.name.matches('.*\\.(pdf|doc|docx|xls|xlsx)$');
    }

    function isValidResume() {
      return isValidDocument() &&
             // Additional resume-specific validation
             request.resource.name.matches('.*resume.*\\.(pdf|doc|docx)$');
    }

    // Rate limiting - max 10 uploads per minute per user
    function isUnderUploadLimit() {
      return request.time > resource == null ? request.time : resource.metadata.lastUploadTimestamp.seconds * 1000 + 6000;
    }

    // Path-based validation
    function isProfileImagePath() {
      return request.resource.name.matches('^consultants/[^/]+/profile\\.(jpg|jpeg|png|gif|webp)$');
    }

    function isResumePath() {
      return request.resource.name.matches('^consultants/[^/]+/resumes/.*\\.(pdf|doc|docx)$');
    }

    function isPortfolioPath() {
      return request.resource.name.matches('^consultants/[^/]+/portfolio/.*');
    }

    // Consultant file storage with validation
    match /consultants/{userId}/{allPaths=**} {
      // Allow consultants to read their own files
      allow read: if isOwner(userId) || isAdmin();
      
      // Allow consultants to write with validation
      allow write: if 
        isOwner(userId) &&
        isUnderUploadLimit() && (
          // Profile images
          (isProfileImagePath() && isValidImage()) ||
          // Resumes
          (isResumePath() && isValidResume()) ||
          // Portfolio items (images and documents)
          (isPortfolioPath() && (isValidImage() || isValidDocument()))
        );
      
      // Allow admins to manage all consultant files
      allow write: if isAdmin();
      
      // Allow authenticated users to read profile images (public profiles)
      allow read: if 
        isSignedIn() && 
        isProfileImagePath();
    }

    // Opportunity-related files (admin only)
    match /opportunities/{opportunityId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && 
        request.resource.size < 10 * 1024 * 1024 && // 10MB limit
        (isValidImage() || isValidDocument());
    }

    // System files (admin only)
    match /system/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Public read-only files (logos, templates, etc.)
    match /public/{allPaths=**} {
      allow read: if true; // Public access
      allow write: if isAdmin();
    }
    
    // Fallback: Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
